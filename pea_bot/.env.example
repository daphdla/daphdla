# Copiez ce fichier en .env et remplissez vos valeurs
# cp .env.example .env

# ── Telegram ──────────────────────────────────────────────────────────────────
# Créez votre bot via @BotFather sur Telegram
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Votre chat ID (obtenez-le via @userinfobot ou @RawDataBot)
TELEGRAM_CHAT_ID=123456789

# ── GitHub (optionnel) ────────────────────────────────────────────────────────
# Token GitHub pour augmenter la limite API (60 → 5000 req/h)
# Créez un token sur https://github.com/settings/tokens (scope: public_repo)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
