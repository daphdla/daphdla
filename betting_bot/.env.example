# ── Sports Betting Mispricing Bot — Environment Variables ──────────────────

# The Odds API  (https://the-odds-api.com — free tier: 500 req/month)
ODDS_API_KEY=your_odds_api_key_here

# Starting bankroll in USD (used for Kelly sizing)
BANKROLL=1000

# ── Telegram ────────────────────────────────────────────────────────────────
# 1. Create a bot: message @BotFather on Telegram → /newbot
# 2. Get your chat ID: curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeffGGhhIIjj...
TELEGRAM_CHAT_ID=-1001234567890

# ── Discord ─────────────────────────────────────────────────────────────────
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
