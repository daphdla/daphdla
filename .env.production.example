# ─── Docker / Production env vars ────────────────────────────────────────────
# Copy to .env and fill in values before running docker compose up

# PostgreSQL
POSTGRES_USER=pe_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=pe_platform

# Computed from the above (used by Prisma + NextAuth)
DATABASE_URL=postgresql://pe_user:change_me_strong_password@db:5432/pe_platform

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_openssl_rand_base64_32_output
AUTH_URL=https://your-domain.com

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=PE Platform

# Optional — exposed host port (default: 3000)
APP_PORT=3000
